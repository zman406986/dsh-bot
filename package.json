{
  "name": "dsh-multitask-dispatcher",
  "description": "Always-on dispatcher for DeepSeek Harness: routes work to workers and teams and reports results in this chat.",
  "version": "0.1.0",
  "keywords": ["cordis", "dsh", "deepseek", "dispatcher", "multitask", "agent"],
  "author": "TZ",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": [
        "react",
        "react/jsx-runtime"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./worker-preset": {
      "types": "./lib/worker/preset.d.ts",
      "import": "./lib/worker/preset.js"
    },
    "./client": "./client/index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:client": "node --import tsx scripts/build-client.ts",
    "check:client": "node --import tsx scripts/build-client.ts --check",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && npm run typecheck:test",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --tsconfig tsconfig.client.json --test test/**/*.test.ts",
    "prepare": "npm run build",
    "prepack": "npm run build:client"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zman406986/dsh-bot.git"
  },
  "homepage": "https://github.com/zman406986/dsh-bot#readme",
  "bugs": {
    "url": "https://github.com/zman406986/dsh-bot/issues"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "26.1.0",
    "react": "^19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
