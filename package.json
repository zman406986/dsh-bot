{
  "name": "dsh-multitask-dispatcher",
  "description": "Always-on multitask dispatcher plugin for DeepSeek Harness (dsh)",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "dsh": {
    "client": {
      "platform": "web",
      "external": [
        "react",
        "react/jsx-runtime"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./client/index.js"
  },
  "files": [
    "lib",
    "client",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:client": "node --import tsx scripts/build-client.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "prepare": "npm run build"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
