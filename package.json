{
  "name": "dsh-multitask-dispatcher",
  "description": "Always-on multitask dispatcher plugin for DeepSeek Harness (dsh)",
  "version": "0.1.0",
  "keywords": ["cordis", "dsh", "deepseek", "dispatcher", "multitask", "agent"],
  "author": "TZ",
  "type": "module",
  "workspaces": ["vendor/racoons/core", "vendor/racoons/adapter"],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": [
        "react",
        "react/jsx-runtime"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./worker-preset": {
      "types": "./lib/worker/preset.d.ts",
      "import": "./lib/worker/preset.js"
    },
    "./client": "./client/index.js"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "vendor/racoons"
  ],
  "bundledDependencies": ["@racoons/core", "racoons-dsh"],
  "scripts": {
    "build:vendor": "tsc -p vendor/racoons/core/tsconfig.json && tsc -p vendor/racoons/adapter/tsconfig.json",
    "build": "npm run build:vendor && tsc -p tsconfig.json",
    "build:client": "node --import tsx scripts/build-client.ts",
    "check:client": "node --import tsx scripts/build-client.ts --check",
    "e2e": "node dev/e2e-mock.mjs",
    "typecheck": "npm run build:vendor && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "pretest": "npm run build:vendor",
    "test": "tsx --tsconfig tsconfig.client.json --test test/**/*.test.ts",
    "lint:docs": "node tools/doc-lint.mjs && node tools/issue-index.mjs --check && node tools/adr-index.mjs --check",
    "prepare": "npm run build",
    "prepack": "npm run build:client"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zman406986/dsh-bot.git"
  },
  "homepage": "https://github.com/zman406986/dsh-bot#readme",
  "bugs": {
    "url": "https://github.com/zman406986/dsh-bot/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*",
    "@racoons/core": "0.1.0",
    "racoons-dsh": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "26.1.0",
    "react": "^19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
