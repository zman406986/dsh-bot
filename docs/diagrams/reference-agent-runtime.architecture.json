  "cards": [
    {
      "dot": "cyan",
      "title": "Dispatch loop",
      "items": [
        "One run per agent, ordered user > peer > background with FIFO inside a lane.",
        "A settle queues a hidden, silence-allowed wake rather than interrupting mid-turn."
      ]
    },
    {
      "dot": "violet",
      "title": "Worker contract",
      "items": [
        "Only the dispatcher spawns; workers get work tools and cannot address the user.",
        "Steer is single-slot and latest-wins; stop is silent and drops a late result."
      ]
    },
    {
      "dot": "emerald",
      "title": "Durable vs in-memory",
      "items": [
        "Durable: the transcript, the todo list, and outstanding-work markers.",
        "In-memory: worker registry, parked steers, queues. Nothing replays a restart."
      ]
    },
    {
      "dot": "amber",
      "title": "Peers and other wakes",
      "items": [
        "Peers exist only between top-level agents; a reply wakes the sender later.",
        "Priority preempts non-user work only. Automations and listeners also wake."
      ]
    }
  ]
